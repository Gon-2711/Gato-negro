<%- include('../partials/header') %>

<style>
    .section-box { background: white; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.08); padding: 20px; margin-bottom: 24px; }
    html.dark-mode .section-box { background: var(--bg-card); border: 1px solid var(--border-color); }
</style>

<div style="margin-bottom: 20px;">
    <h1 style="margin: 0;">⚖️ Recepción de Envolvedoras</h1>
    <p style="color: gray; margin-top: 5px;">Recibe los tabacos ya envueltos y registra mermas.</p>
</div>

<div class="section-box" style="border-top: 4px solid #10b981;">
    <h2 style="margin-top: 0; color: #065f46;">✔ Recepción de Tabacos Envueltos</h2>
    
    <form action="/api/envolvedoras/recibir" method="POST">
        <div style="display: flex; gap: 20px; flex-wrap: wrap; align-items: flex-end;">
            
            <div style="flex: 2; min-width: 220px;">
                <label style="font-weight:bold; display:block; margin-bottom:4px; font-size:13px;">1. Seleccionar Envolvedora:</label>
                <select name="empleado_id" style="width: 100%; padding: 8px; border: 2px solid #10b981; border-radius: 6px; font-size: 14px;" required>
                    <option value="">-- Elige un Empleado --</option>
                    <% empleados.forEach(e => { %>
                        <option value="<%= e.id %>"><%= e.nombre %></option>
                    <% }) %>
                </select>
            </div>
            
            <div style="flex: 1; min-width: 150px;">
                <label style="font-weight:bold; display:block; margin-bottom:4px; font-size:13px; color: #065f46;">2. Tabacos Envueltos (OK):</label>
                <input type="number" name="tabacos_envueltos" style="width: 100%; padding: 8px; border: 2px solid #10b981; border-radius: 6px; font-size: 16px; font-weight: bold; background: #f0fdf4;" required placeholder="Ej. 1000">
            </div>

            <div style="flex: 1; min-width: 150px;">
                <label style="font-weight:bold; display:block; margin-bottom:4px; font-size:13px; color: #b91c1c;">3. Merma de Papel (g):</label>
                <input type="number" name="merma_papel" style="width: 100%; padding: 8px; border: 2px solid #fca5a5; border-radius: 6px; font-size: 16px; background: #fef2f2;" value="0">
            </div>

            <div style="flex: 1; min-width: 150px;">
                <label style="font-weight:bold; display:block; margin-bottom:4px; font-size:13px; color: #b91c1c;">4. Merma de Tabacos:</label>
                <input type="number" name="merma_tabacos" style="width: 100%; padding: 8px; border: 2px solid #fca5a5; border-radius: 6px; font-size: 16px; background: #fef2f2;" value="0">
            </div>
        </div>
        
        <button type="submit" style="margin-top: 16px; background: #10b981; color: white; padding: 10px 24px; font-size: 15px; font-weight: bold; border: none; border-radius: 6px; cursor: pointer;">
            ✔ Guardar Recepción
        </button>
    </form>
</div>

<%- include('../partials/footer') %>
